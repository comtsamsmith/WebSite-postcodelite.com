---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Page } from '../data/pages';
interface Props { page: Page }
const { page } = Astro.props;
const isHome = page.path === 'default.htm';
const docs = page.eyebrow === 'Developer documentation';
---
<BaseLayout title={page.title} description={page.intro} path={page.path}>
  <section class:list={['hero', isHome && 'hero-home', docs && 'hero-docs']}>
    <div class="hero-copy">
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{page.title}</h1>
      <p class="lead">{page.intro}</p>
      {isHome && <div class="actions"><a class="button primary" href="https://www.postcodelite.co.uk/A2CustomerAccount/WebAccountCreate.aspx">Start your evaluation <span>↗</span></a><a class="button secondary" href="/WebIntegration.htm">Explore integrations</a></div>}
      {!isHome && !docs && <div class="actions"><a class="button primary" href="https://www.postcodelite.co.uk/A2CustomerAccount/WebAccountCreate.aspx">Create an account <span>↗</span></a><a class="text-link" href="/contact.htm">Contact support →</a></div>}
    </div>
    <div class="lookup-card" aria-label="Illustrative postcode lookup">
      <div class="card-top"><span class="status-dot"></span><span>Postcode lookup</span><span class="live">LIVE</span></div>
      <label for="demo-postcode">UK postcode</label>
      <div class="search-row"><input id="demo-postcode" value="PE13 2QL" readonly /><button type="button">Find address</button></div>
      <div class="result"><span class="pin">⌖</span><div><strong>Address found</strong><span>Wisbech, Cambridgeshire</span></div><span class="check">✓</span></div>
      <p>Illustrative interface</p>
    </div>
  </section>

  {isHome && <section class="trust-strip"><span>Designed for</span><strong>Office teams</strong><strong>Software developers</strong><strong>Web checkout</strong><strong>Internal systems</strong></section>}

  <section class:list={['content-grid', docs && 'docs-grid']}>
    <div class="section-index">
      <span>{String(page.sections.length).padStart(2, '0')}</span>
      <p>{docs ? 'Documentation sections' : 'Things to know'}</p>
    </div>
    <div class="sections">
      {page.sections.map((section, index) => <article class="content-section">
        <div class="section-number">{String(index + 1).padStart(2, '0')}</div>
        <div>
          <h2>{section.heading}</h2>
          {section.body?.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
          {section.code && <pre><code>{section.code}</code></pre>}
        </div>
      </article>)}
    </div>
  </section>

  <section class="cta-band">
    <div><p class="eyebrow">Ready when you are</p><h2>Make address entry feel effortless.</h2></div>
    <div><p>Start with one postcode area for 30 days, then choose the data and licence that fit your organisation.</p><a class="button light" href="https://www.postcodelite.co.uk/A2CustomerAccount/WebAccountCreate.aspx">Create an account <span>↗</span></a></div>
  </section>
</BaseLayout>
